# Apache / shared-host configuration for the Absolut Dimension static build.
# Copied into dist/ by Vite. Safe to leave in place on other hosts.

# -----------------------------------------------------------------------------
# SPA routing — any request that doesn't match a real file should fall through
# to index.html so React Router handles it on the client.
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pass real files through unchanged
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else -> index.html (200, not a redirect)
  RewriteRule . /index.html [L]
</IfModule>

# -----------------------------------------------------------------------------
# Compression — brotli when available, gzip as fallback.
# -----------------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/xml text/plain \
                                        application/javascript application/json \
                                        application/xml image/svg+xml font/ttf \
                                        font/otf font/woff font/woff2
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/xml text/plain \
                                application/javascript application/json \
                                application/xml image/svg+xml font/ttf \
                                font/otf font/woff font/woff2
</IfModule>

# -----------------------------------------------------------------------------
# Cache lifetimes by asset class.
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Hashed build artefacts (Vite fingerprints these) — cache forever
  ExpiresByType text/css                   "access plus 1 year"
  ExpiresByType application/javascript     "access plus 1 year"
  ExpiresByType text/javascript            "access plus 1 year"

  # Imagery — a month, with SWR-style freshness via Cache-Control below
  ExpiresByType image/jpeg                 "access plus 30 days"
  ExpiresByType image/png                  "access plus 30 days"
  ExpiresByType image/webp                 "access plus 30 days"
  ExpiresByType image/avif                 "access plus 30 days"
  ExpiresByType image/svg+xml              "access plus 30 days"

  # Fonts
  ExpiresByType font/woff2                 "access plus 1 year"
  ExpiresByType font/woff                  "access plus 1 year"

  # HTML — always revalidate so users see the latest deploy
  ExpiresByType text/html                  "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Hashed assets — immutable
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Imagery — one month + stale-while-revalidate
  <FilesMatch "\.(jpg|jpeg|png|webp|avif|svg)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>

  # HTML — must revalidate
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Security posture
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# -----------------------------------------------------------------------------
# Keep-alive speeds up multi-asset page loads on traditional hosts.
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set Connection keep-alive
</IfModule>
