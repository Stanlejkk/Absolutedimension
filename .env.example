# Absolut Dimension — environment variables
#
# Copy this file to `.env.local` and fill in the values for your environment.
# Variables prefixed with VITE_ are embedded into the client bundle at build
# time; never put server-only secrets here.

# ─── Supabase ───────────────────────────────────────────────────────────────
# Point these at your Supabase project. When both are set, products,
# collections, blog posts and accounts are read from Supabase. Leave them
# blank during local dev to fall back to the bundled seed data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Admin ──────────────────────────────────────────────────────────────────
# Invitation code required to register an account with the "admin" role.
# Falls back to "ATELIER-ADMIN" when unset.
VITE_ADMIN_INVITE_CODE=

# ─── Shop (Stripe) ──────────────────────────────────────────────────────────
# URL the cart POSTs to in order to create a Stripe Checkout Session.
# In production this is served by the Vercel Function in /api/checkout.
VITE_STRIPE_CHECKOUT_URL=/api/checkout

# Public site origin — used by server-side code to build success / cancel
# URLs and absolute links in newsletter emails.
VITE_SITE_URL=http://localhost:5173

# ─── Server-only secrets ────────────────────────────────────────────────────
# NEVER prefix these with VITE_ (they must not be bundled into the client).
# On Vercel, add them via the project's Environment Variables UI.

# Stripe (test mode keys start with sk_test_ / whsec_)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase service-role key — bypasses RLS, used by the webhook and newsletter
# subscribe endpoint to insert rows on behalf of anonymous users.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com). RESEND_FROM must be a verified sender.
RESEND_API_KEY=
RESEND_FROM="Absolut Dimension <studio@absolutdimension.com>"
