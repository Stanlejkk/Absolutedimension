# Absolut Dimension — environment variables
#
# Copy this file to `.env.local` and fill in the values for your environment.
# Variables prefixed with VITE_ are embedded into the client bundle at build
# time; never put server-only secrets here.

# ─── Supabase ───────────────────────────────────────────────────────────────
# Point these at your Supabase project. When both are set, products,
# collections, blog posts and accounts are read from Supabase. Leave them
# blank during local dev to fall back to the bundled seed data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Admin ──────────────────────────────────────────────────────────────────
# Invitation code required to register an account with the "admin" role.
# Falls back to "ATELIER-ADMIN" when unset.
VITE_ADMIN_INVITE_CODE=
